{
  "name": "bucketlist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "test": "node --test",
    "build": "node scripts/build-standalone.mjs",
    "test:browser": "node tests/browser.cjs",
    "test:showcase": "node tests/showcase.cjs",
    "test:calendar": "node tests/calendar.cjs",
    "build:web": "npm run build && node scripts/build-web.mjs",
    "test:phone": "node tests/phone.cjs",
    "publish:web": "npm run build:web && node scripts/publish-web.mjs",
    "preview:web": "node scripts/preview-web.mjs",
    "refresh:courts": "node scripts/refresh-courts.mjs",
    "test:courts": "node tests/courts.cjs",
    "test:location": "node tests/location.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "qrcode": "1.5.4"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3"
  }
}
